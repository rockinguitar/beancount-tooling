SELECT 
    date AS "Datum", 
    narration AS "Buchungstext", 
    abs(position) as "Betrag",
    any_meta('zahler') as "Zahler",
    any_meta('quelle') as "Quelle"
WHERE "Income:Mitgliedsbeitraege" IN accounts
AND account = "Income:Mitgliedsbeitraege"
{{- if .From }}
  AND date >= {{ .From }}
{{- end }}
{{- if .To }}
  AND date <= {{ .To }}
{{- end }}
ORDER BY date;
